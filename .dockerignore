# Git and CI
.git
.github
.gitignore

# Build artifacts
target/
**/target/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local data and logs
data/
*.db
*.log
logs/
*.tmp
*.temp
*.bak
*.backup

# Docs and non-runtime assets (keep proto + config for build/runtime)
docs/
*.md
!README.MD
!README.md

# Scripts / monitoring not needed for binary image build.
# Keep benches/ and tests/ — Cargo.toml declares them and fails to parse if missing.
scripts/
monitoring/
# keep config/ for docker.toml
!config/

# Debug / alternate Docker files
Dockerfile.debug
docker-compose.yml
Makefile

# Misc tooling configs (not required to compile)
clippy.toml
rustfmt.toml
deny.toml
.cargo/
